 
@section styles
{
}

@await Html.PartialAsync("~/Views/Shared/Partials/_PageTitle.cshtml")

 <div class="row">
    <div class="col-lg-12">
        <form class="bg-light-subtle rounded border p-3">

            <div class="row gap-3">
                <div class="col-lg-4">
                    <div class="app-search">
                        <input type="text" class="form-control" placeholder="Search contact name...">
                        <i data-lucide="search" class="app-search-icon text-muted"></i>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="me-2 fw-semibold">Filter By:</span>

                        <!-- Designation Filter -->
                        <div class="app-search">
                            <select class="form-select form-control my-1 my-md-0">
                                <option selected>Designation</option>
                                <option value="Manager">Manager</option>
                                <option value="Developer">Developer</option>
                                <option value="Designer">Designer</option>
                                <option value="Sales">Sales</option>
                                <option value="Support">Support</option>
                            </select>
                            <i data-lucide="user-check" class="app-search-icon text-muted"></i>
                        </div>

                        <!-- Location Filter -->
                        <div class="app-search">
                            <select class="form-select form-control my-1 my-md-0">
                                <option selected>Location</option>
                                <option value="USA">USA</option>
                                <option value="UK">UK</option>
                                <option value="Germany">Germany</option>
                                <option value="India">India</option>
                                <option value="Canada">Canada</option>
                            </select>
                            <i data-lucide="map-pin" class="app-search-icon text-muted"></i>
                        </div>

                        <!-- Department Filter -->
                        <div class="app-search">
                            <select id="UsersList" class="form-select form-control my-1 my-md-0">
                                
                            </select>
                            <i data-lucide="layers" class="app-search-icon text-muted"></i>
                        </div>

                        <button type="submit" class="btn btn-secondary">Apply</button>

                        <div role="group" aria-label="Layout toggle button group" class="ms-auto flex-shrink-0">
                            <input type="radio" class="btn-check" name="btnradio" id="btnradio1" checked>
                            <label class="btn btn-soft-primary btn-icon" for="btnradio1">
                                <i data-lucide="layout-grid" class="fs-lg"></i>
                            </label>

                            <input type="radio" class="btn-check" name="btnradio" id="btnradio2">
                            <label class="btn btn-soft-primary btn-icon" for="btnradio2">
                                <i data-lucide="list" class="fs-lg"></i>
                            </label>
                        </div>

                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="row">
    <div id="contenedor-usuarios">
        <div class="text-muted p-3">Cargando usuarios desde el Gateway de Ignition...</div>
    </div>
</div>


<script>
    $(document).ready(function(){
        $.get("/UsersIgnition/GetUserSourcesDropdown", function(htmlRenderizado) {
            console.log(htmlRenderizado);

            var dropdown = $("#UsersList");
            
            dropdown.empty();
            dropdown.append('<option value="">Select User Source...</option>');

            if (htmlRenderizado && htmlRenderizado.length > 0) {
                $.each(htmlRenderizado, function(index, perfil) {
                    dropdown.append(
                        $('<option></option>').val(perfil.name).text(perfil.name)
                    );
                });
            }

            // ⭐ AQUÍ EXACTAMENTE ES DONDE LO TIENES QUE AGREGAR:
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }).fail(function() {
            $("#contenedor-usuarios").html("<div class='alert alert-danger'>Error crítico al conectar con la aplicación web.</div>");
        });


        // Invocar la acción mapeada de tu controlador C#
        /*
        $.get("/UsersIgnition/GetIgnitionCards", function(htmlRenderizado) {
            // Limpiar el mensaje de carga e inyectar las tarjetas
            $("#contenedor-usuarios").empty().html(htmlRenderizado);
        }).fail(function() {
            $("#contenedor-usuarios").html("<div class='alert alert-danger'>Error crítico al conectar con la aplicación web.</div>");
        });
        */


        // 1. Capturamos el valor actual de tu dropdown (si está vacío, dejamos "NewProfile")
        var fuenteSeleccionada = $("#UsersList").val() || "NewProfile";

        // 2. ⭐ CORRECCIÓN CLAVE: Le pegamos el parámetro usando la variable de JavaScript
        $.get("/UsersIgnition/GetIgnitionCards?user_source=" + fuenteSeleccionada, function(htmlRenderizado) {
            // Limpiar el mensaje de carga e inyectar las tarjetas
            $("#contenedor-usuarios").empty().html(htmlRenderizado);
        }).fail(function() {
            $("#contenedor-usuarios").html("<div class='alert alert-danger'>Error crítico al conectar con la aplicación web.</div>");
        });

        $("#UsersList").change(function() {
            // 1. Obtener el valor seleccionado (ej. "default", "NewProfile")
            var valorSeleccionado = $(this).val();

            // 2. Validar que no sea la opción vacía por defecto
            if (valorSeleccionado !== "") {
                // ⭐ Dispara la alerta con el valor del perfil
                //alert("Has seleccionado la fuente de usuarios: " + valorSeleccionado);
                var fuenteSeleccionada = valorSeleccionado;

                // 2. ⭐ CORRECCIÓN CLAVE: Le pegamos el parámetro usando la variable de JavaScript
                $.get("/UsersIgnition/GetIgnitionCards?user_source=" + fuenteSeleccionada, function(htmlRenderizado) {
                    // Limpiar el mensaje de carga e inyectar las tarjetas
                    $("#contenedor-usuarios").empty().html(htmlRenderizado);
                }).fail(function() {
                    $("#contenedor-usuarios").html("<div class='alert alert-danger'>Error crítico al conectar con la aplicación web.</div>");
                });


            }
        });





    });
</script>

